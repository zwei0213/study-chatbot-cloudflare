{
  "name": "study-chatbot-cloudflare",
  "version": "3.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbo",
    "build": "next build",
    "start": "next start",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "wrangler d1 migrations apply study-chatbot-db --remote && opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "check": "ultracite check",
    "fix": "ultracite fix",
    "db:migrate": "wrangler d1 migrations apply study-chatbot-db --remote",
    "db:migrate:local": "wrangler d1 migrations apply study-chatbot-db --local"
  },
  "dependencies": {
    "bcrypt-ts": "^8.0.1",
    "drizzle-orm": "^0.45.2",
    "next": "16.3.6",
    "next-auth": "5.0.0-beta.25",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "server-only": "^0.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.2",
    "@opennextjs/cloudflare": "^1.20.7",
    "@tailwindcss/postcss": "^4.3.2",
    "@types/node": "^24.13.2",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "babel-plugin-react-compiler": "^1.0.0",
    "postcss": "^8",
    "tailwindcss": "^4.3.2",
    "typescript": "^5.6.3",
    "ultracite": "^7.8.4",
    "wrangler": "^4.145.0"
  },
  "packageManager": "pnpm@10.32.1"
}
